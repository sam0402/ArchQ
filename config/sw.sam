#!/bin/bash
#serv=$(echo $0 | awk -F/ '{print $NF}')
key="eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJpc3MiOiJlMjQ3OWIyNDc0ODI0ZjYwODNlOTdiOGI0MDllN2ZiMiIsImlhdCI6MTY5MzQwMzcwNSwiZXhwIjoyMDA4NzYzNzA1fQ.VsKf7iZO-nv1MWSVCm8f-8Lsah9S0T9NaqoIQLyimHY"

if [ -z $1 ]; then
	echo "Using: sw mpd, roon, lms, rompr, airplay, mtroom, hqe, naa and other service."
	exit 1
fi
cmd=$(echo "$1" | tr -d '"' | tr '[:upper:]' '[:lower:]')
serv=$cmd
service=$serv
MPD='mpd'

case $cmd in
	airplay|shairport-sync)
		serv=shairport-sync
		service='shairport-sync nqptp'
		;;
	roon|roonserver)
		serv=roonserver
		service=roonserver
		;;
	mpd)
		serv=mpd
		service='mpd-plugin '$MPD
		;;
	mtroom|owntone)
		# user="--user"
		serv="owntone"
		service='avahi-daemon owntone mpd-plugin '$MPD
		;;
	qobuz)
		serv=mpd
		service='avahi-daemon mpd upmpdcli '$MPD
		;;
	rompr)
		serv=nginx
		service='avahi-daemon nginx php-fpm '$MPD
		;;
	mympd)
		serv=mympd
		service='mympd '$MPD
		;;
	lms|lyrionmusicserver)
		serv=lyrionmusicserver
		service="$serv squeezelite"
		;;
	hqe|hqplayerd)
		serv=hqplayerd
		service='hqplayerd'
		;;
	naa|networkaudio)
		serv=networkaudio
		service='networkaudio'
		;;
esac

if [[ -n $user ]]; then
	[[ $(systemctl is-active --user $serv) == active ]] && systemctl stop --user $service || systemctl start --user $service
else
	if [[ $(systemctl is-active $serv) == active ]]; then 
		STATUS='off'
		sudo systemctl stop $service
	else
		STATUS='on'
		sudo systemctl start $service
		if systemctl is-active mpd >/dev/null && [ "$cmd" = mpd ]; then
			mpc enable ArchQ >/dev/null 2>&1
			chrt -fp 35 $(pgrep mpd)
			chrt -fp 45 $(pgrep ksoftirqd/$(ps -eLo comm,cpuid| grep "output:"|awk '{print $2}'))
			mpc disable Multiroom >/dev/null; mpc disable Stream >/dev/null
		fi
		if systemctl is-active owntone >/dev/null && [[ "$cmd" = mtroom || "$cmd" = owntone ]]; then
			mpc enable Multiroom >/dev/null; mpc disable ArchQ >/dev/null
			chrt -p 61 $(pidof -s owntone)
			chrt -p 93 $(ps -T -C owntone -o tid,comm= | awk '$2=="player"{print $1}')
			chrt -p 91 $(ps -T -C owntone -o tid,comm= | awk '$2=="input"{print $1}')
		fi
	fi
	curl -X POST -H "Authorization: Bearer $key" -H "Content-Type: application/json" -d '{"state": "'$STATUS'"}' \
	http://192.168.1.2:8123/api/states/switch.$cmd >/dev/null 2>&1
fi

echo Service $service is $'\e[1;38;5;196m'$(systemctl is-active $user $serv)$'\e[m'.
